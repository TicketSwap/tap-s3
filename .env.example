# S3 Configuration
# Copy this file to .env and fill in your actual values
#
# Authentication uses the default AWS credential chain (boto3.Session), so make
# sure you're already logged in, e.g.: aws sso login --profile my-profile

# Required: The S3 bucket containing the Parquet files to extract
TAP_S3_BUCKET=my-bucket

# Optional: Folder (key prefix) within the bucket to read Parquet files from
TAP_S3_PREFIX=exports/2026-08-01/

# Optional: Named AWS profile to use (e.g. an SSO profile). Leave unset to use
# the default profile.
TAP_S3_AWS_PROFILE=my-sso-profile

# Optional: AWS region of the S3 bucket. Leave unset to use your AWS config's
# default region.
TAP_S3_AWS_REGION=eu-west-1
